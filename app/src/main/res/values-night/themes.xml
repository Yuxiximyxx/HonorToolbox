<resources>
    <!-- 深色模式窗口背景：与页面 surface 对齐（v1.6.6）——miuix 0.8.8 默认深色方案 surface 为纯黑（库源码 Colors.kt darkColorScheme 核实），原 #FF121212 比页面亮一档，内容没画到的手势条区域会露出一条灰黑带；运行时再由 MainActivity 的 SideEffect 按生效深浅设一遍同值，覆盖软件内强制深浅与系统不一致的情况。 -->
    <style name="Theme.HonorToolbox" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FF000000</item>
    </style>
</resources>
