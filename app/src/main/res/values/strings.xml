<resources>
    <string name="app_name">荣耀工具箱</string>
    <!-- MagicXM4 详情页标题（v1.5.0 合入，原 MagicXM4 同名资源） -->
    <string name="detail_device_name">WH-1000XM4</string>
    <string name="app_subtitle">荣耀 MagicOS 功能合集：手势改向、通知中心主题、桌面图标日夜切换等</string>

    <!-- 作用域：SystemUI（通知中心主题 + 导航条唤醒）、快服务
         （手势改向落点）、启动器（图标日夜切换 + 桌面卡片探针） -->
    <string-array name="xposedscope">
        <item>com.android.systemui</item>
        <item>com.hihonor.systemui</item>
        <item>com.hihonor.magicvoice</item>
        <item>com.hihonor.brain</item>
        <item>com.hihonor.servicecenter</item>
        <item>com.hihonor.android.launcher</item>
        <!-- 资源库增强（LibraryPlus 合入，v1.3.0）：资源库与荣耀搜索 -->
        <item>com.hihonor.hiboard</item>
        <item>com.hihonor.search</item>
        <!-- 自身包名：缺了它 LSPosed 不把模块注入工具箱自己的
             进程，激活自检标记永远命中不了（v1.2.1 首页误报
             「模块未激活」的根因；QuickGesture 单模块的作用
             域一直含自身包名）。 -->
        <item>io.github.yuxiximyxx.honortoolbox</item>
        <!-- MagicPods（v1.4.0 合入）：蓝牙协议、荣耀耳机面板、
             SWS 媒体输出、设备中心（控制中心）；
             com.android.systemui 已在上方（与通知中心主题共用） -->
        <item>com.android.bluetooth</item>
        <item>com.hihonor.audioaccessorymanager</item>
        <item>com.hihonor.imedia.sws</item>
        <item>com.hihonor.controlcenter</item>
    </string-array>

