<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 包可见性（合并自各功能原声明，取并集）：
         1. 选卡枚举（通知中心头部卡片）：十个服务卡片来源包 + APPWIDGET_UPDATE 意图；
         2. 选目标应用（手势改向 / 导航条唤醒）：MAIN / MAIN+LAUNCHER 意图查询，
            不申请 QUERY_ALL_PACKAGES。 -->
    <queries>
        <package android:name="com.hihonor.magicvoice" />
        <package android:name="com.hihonor.brain" />
        <package android:name="com.android.systemui" />
        <package android:name="com.hihonor.systemui" />
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <package android:name="com.hihonor.android.totemweather" />
        <package android:name="com.hihonor.calendar" />
        <package android:name="com.hihonor.deskclock" />
        <package android:name="com.hihonor.contacts" />
        <package android:name="com.hihonor.photos" />
        <package android:name="com.hihonor.wallet" />
        <package android:name="com.hihonor.magichome" />
        <package android:name="com.hihonor.parentcontrol" />
        <package android:name="com.hihonor.android.launcher" />
        <package android:name="com.hihonor.notepad" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <!-- 资源库增强（LibraryPlus 合入）：只有同签名的应用能发送
         配置变更 / 重启作用域广播（原独立版同款 signature 权限，
         随工具箱包名改名，见 libraryplus/LpConfig.kt 的 Const）。 -->
    <!-- MagicPods（v1.4.0 合入）：耳机详情页与控制中心磁贴
         需要的蓝牙/通知权限（原 MagicPods 同款声明） -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <permission
        android:name="io.github.yuxiximyxx.honortoolbox.permission.CONFIG"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.yuxiximyxx.honortoolbox.permission.CONFIG" />

    <application
        android:label="@string/app_name"
        android:description="@string/app_subtitle"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:extractNativeLibs="false"
        android:enableOnBackInvokedCallback="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.HonorToolbox">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|locale|mcc|navigation|smallestScreenSize|touchscreen|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>



        <!-- 长按导航条后弹出的底部选择框。SystemUI 跨包拉起，必须 exported（原 NavWake 同款声明）。 -->
        <activity
            android:name=".navwake.ChooserActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="长按唤醒谁？"
            android:theme="@style/Theme.HonorToolbox.Chooser" />




        <!-- MagicPods 耳机详情页（v1.4.0 合入）：控制中心卡片
             点击经 setClassName 直达本 Activity，必须 exported
             （原 MagicPods 同款声明，主题沿用其 DeviceDefault） -->
        <activity
            android:name=".magicpods.EarphoneDetailActivity"
            android:exported="true"
            android:label="OPPO Enco Free4"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- MagicPods 控制中心降噪快捷磁贴（原 MagicPods 同款） -->
        <service
            android:name=".magicpods.hook.QuickSettingsAncTile"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="MagicPods"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- MagicXM4 耳机详情页（v1.5.0 合入）：控制中心卡片
             点击经 setClassName 直达本 Activity，必须 exported
             （原 MagicXM4 同款声明，主题沿用其 DeviceDefault） -->
        <activity
            android:name=".magicxm4.EarphoneDetailActivity"
            android:exported="true"
            android:label="WH-1000XM4"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- MagicXM4 控制中心降噪快捷磁贴（原 MagicXM4 同款） -->
        <service
            android:name=".magicxm4.hook.QuickSettingsAncTile"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="MagicXM4"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 资源库增强的配置 Provider（原 LibraryPlus 同款，authority
             随工具箱包名改名）：被 hook 进程读配置、上报生效状态。 -->
        <provider
            android:name=".libraryplus.ConfigProvider"
            android:authorities="io.github.yuxiximyxx.honortoolbox.config"
            android:exported="true" />

        <!-- 快服务手势改向的配置 Provider（v1.6.5）：文件通道在
             快服务进程里读不到、Settings.Global 通道写不进去，
             改由 hook 进程经本 Provider 跨进程读当前配置
             （call("get")，数据源与设置页同源的镜像偏好）。
             authority 与资源库那个错开。 -->
        <provider
            android:name=".quickgesture.QuickGestureConfigProvider"
            android:authorities="io.github.yuxiximyxx.honortoolbox.quickgesture"
            android:exported="true" />

        <!-- Xposed Module 声明（传统 API） -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="荣耀工具箱：MagicOS 功能合集——快服务手势改向、长按导航条唤醒改向、通知中心主题（锁屏主题样式渲染）、桌面图标随日夜切换、资源库增强与荣耀搜索净化、掌盟净化。" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
        <!-- 资源库增强经 LSPosed new-xshared 下发配置（原 LibraryPlus 同款声明） -->
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
    </application>

</manifest>
